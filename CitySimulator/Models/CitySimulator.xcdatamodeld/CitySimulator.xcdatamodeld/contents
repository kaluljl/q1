    @NSManaged public var health: String
    @NSManaged public var happiness: Double
    @NSManaged public var income: Double
    @NSManaged public var residence: UUID?
    @NSManaged public var workplace: UUID?
}

extension TaskEntity {
    @nonobjc public class func fetchRequest() -> NSFetchRequest<TaskEntity> {
