import Foundation
import CoreData

// Core Data实体定义
extension CityEntity {
    @nonobjc public class func fetchRequest() -> NSFetchRequest<CityEntity> {
        return NSFetchRequest<CityEntity>(entityName: "CityEntity")
    }
    
    @NSManaged public var name: String
    @NSManaged public var level: Int32
    @NSManaged public var experience: Int32
    @NSManaged public var gridSize: Int32
    @NSManaged public var foundedDate: Date
    @NSManaged public var lastPlayedDate: Date
    @NSManaged public var totalBuildings: Int32
    @NSManaged public var totalPopulation: Int32
    @NSManaged public var totalIncome: Double
    @NSManaged public var totalExpenses: Double
    @NSManaged public var happiness: Double
    @NSManaged public var environment: Double
}

extension BuildingEntity {
    @nonobjc public class func fetchRequest() -> NSFetchRequest<BuildingEntity> {
        return NSFetchRequest<BuildingEntity>(entityName: "BuildingEntity")
    }
    
    @NSManaged public var id: UUID
    @NSManaged public var type: String
    @NSManaged public var level: Int32
    @NSManaged public var positionX: Int32
    @NSManaged public var positionY: Int32
    @NSManaged public var buildTime: Date
    @NSManaged public var lastUpgradeTime: Date?
    @NSManaged public var lastMaintenanceTime: Date
    @NSManaged public var capacity: Int32
    @NSManaged public var income: Double
    @NSManaged public var maintenanceCost: Double
    @NSManaged public var happinessBonus: Double
    @NSManaged public var pollutionLevel: Double
    @NSManaged public var isUnderConstruction: Bool
    @NSManaged public var isMaintenanceRequired: Bool
    @NSManaged public var isUpgrading: Bool
}

extension ResourceEntity {
    @nonobjc public class func fetchRequest() -> NSFetchRequest<ResourceEntity> {
        return NSFetchRequest<ResourceEntity>(entityName: "ResourceEntity")
