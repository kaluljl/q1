# local.properties 示例（请复制为 local.properties 并填写真实值，勿提交到版本库）
# 该文件仅在本机存在，用于 Gradle 读取并注入 BuildConfig

# DeepSeek 或其他第三方 API 密钥
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Supabase 客户端配置（仅使用匿名密钥，切勿在客户端放置 service role key）
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
